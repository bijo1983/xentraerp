# Copy to keystore.properties (same directory, already gitignored) for a
# LOCAL signed release build. CI (.github/workflows/android-release.yml)
# writes its own copy of this file from GitHub Actions secrets instead —
# you don't need this file there.
storeFile=/absolute/path/to/xentraerp-pos-release.keystore
storePassword=changeme
keyAlias=xentraerp-pos
keyPassword=changeme
