# ── XentraERP tenancy configuration (S1 thin slice) ─────────────
# All optional. With none set, the app behaves exactly as before,
# pointing at the single default ERPNext backend.

# Default tenant identity
XENTRA_DEFAULT_TENANT_ID=default
XENTRA_DEFAULT_TENANT_CODE=default
XENTRA_DEFAULT_COMPANY_NAME=XentraERP

# Tenancy model for the default tenant: 'company' (SMB, shared site,
# one Company per tenant) or 'site' (large/enterprise, dedicated site).
XENTRA_DEFAULT_TENANCY_MODEL=company

# ERPNext backend binding for the default tenant
ERP_HOST_IP=127.0.0.1
ERP_PORT=8001
ERP_HOST=erp.badmintonbooking.com

# For 'company' tenancy: the ERPNext Company this tenant maps to
# XENTRA_DEFAULT_ERP_COMPANY=YMH Trading LLC

# Branding (per-tenant look; omit to keep the app default theme)
XENTRA_PRODUCT_NAME=XentraERP
# XENTRA_THEME_PRIMARY=#4338CA
# XENTRA_THEME_ACCENT=#10B981

# ── Multi-tenant registry (extension point) ─────────────────────
# JSON array of TenantConfig objects. Once slug routing is added, a
# request for /<code> resolves to the matching tenant. Each tenant may
# use a different tenancy model and backend binding (company-per-tenant
# for SMB, site-per-tenant for large). Later this is replaced by a
# control-plane DB / master-site Tenant DocType lookup.
#
# XENTRA_TENANTS='[
#   {"id":"t_ymh","code":"ymh","companyName":"YMH Trading LLC","tenancyModel":"company",
#    "backend":{"hostIp":"127.0.0.1","port":8001,"host":"erp.badmintonbooking.com"},
#    "company":"YMH Trading LLC",
#    "branding":{"productName":"YMH ERP","theme":{"primary":"#4338CA","accent":"#10B981","mode":"light"}}},
#   {"id":"t_acme","code":"acme","companyName":"ACME Industries","tenancyModel":"site",
#    "backend":{"hostIp":"10.0.0.5","port":8001,"host":"acme.erp.internal"},
#    "branding":{"productName":"ACME ERP","theme":{"primary":"#556B2F","accent":"#D4AF37"}}}
# ]'
